# ===========================================================================
#  PSS06 - PRGI Title Verification System
#  Single .env shared by the Python AI service and the Node backend.
#
#  This is the TEMPLATE. Copy it to .env and fill in the two secrets
#  below. .env is git-ignored; this file is the one you commit.
# ===========================================================================

# --- MySQL -----------------------------------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=prgi
MYSQL_POOL_SIZE=10

# --- Node / Express backend -------------------------------------------------
PORT=5000
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# --- Python AI service ------------------------------------------------------
AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=8000
AI_SERVICE_URL=http://127.0.0.1:8000
AI_TIMEOUT_MS=120000

# --- Neural models ----------------------------------------------------------
# LITE_MODE:  auto  = use BGE-M3 + FAISS if installed, otherwise fall back
#             true  = always use the TF-IDF fallback (no downloads)
#             false = require the real models, fail loudly if missing
LITE_MODE=auto
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
EMBEDDING_BATCH_SIZE=64
TOP_K_RETRIEVE=25
TOP_K_RERANK=10
TOP_K_RETURN=5

# --- Ollama (explanation layer only) ----------------------------------------
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=45

# --- Symbolic thresholds (tune on a labelled validation set) ----------------
T_REJECT=0.85
T_REVIEW=0.65
T_PHONETIC=0.90
T_FUZZY=0.88
T_CORE_OVERLAP=0.80
T_CROSS_LANGUAGE=0.82

# --- Similarity fusion weights (must sum to 1.0) ----------------------------
W_SEMANTIC=0.35
W_RERANK=0.25
W_FUZZY=0.20
W_PHONETIC=0.10
W_TOKEN=0.10

#Google authenticator 
VITE_GOOGLE_CLIENT_ID=1098245287712-g4jllkcvmal75n994e0vccg6bkff7h38.apps.googleusercontent.com

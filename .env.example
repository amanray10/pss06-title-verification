# ===========================================================================
#  PSS06 - PRGI Title Verification System
#  Single .env shared by the Python AI service and the Node backend.
#
#  This is the TEMPLATE. Copy it to .env and fill in the secrets marked
#  CHANGE_ME below. .env is git-ignored; this file is the one you commit.
#
#      Windows :  copy .env.example .env
#      macOS   :  cp .env.example .env
# ===========================================================================

# --- MySQL -----------------------------------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=CHANGE_ME_your_mysql_password
MYSQL_DATABASE=prgi
MYSQL_POOL_SIZE=10

# --- Node / Express backend -------------------------------------------------
PORT=5000
# CHANGE_ME. Must be at least 32 characters - the server refuses to start in
# production without it and generates a throwaway key in development.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_run_the_command_above_and_paste_the_output_here
JWT_EXPIRES_IN=7d

# --- Review authority -------------------------------------------------------
# Comma-separated allowlist. ONLY these addresses keep Administrator rights
# when signing in through Google. Every other Google sign-in is an ordinary
# applicant and cannot accept or reject titles.
ADMIN_EMAILS=admin@prgi.gov

# --- Email (password resets + review-decision notices) ----------------------
# Optional. With these unset the app still runs; password resets fall back to
# showing the new password on screen and review decisions are not emailed.
#
# For Gmail you need an APP PASSWORD, not your account password:
#   1. Turn on 2-Step Verification on the Google account
#   2. https://myaccount.google.com/apppasswords  ->  generate
#   3. Paste the 16 characters below (spaces are stripped automatically)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=CHANGE_ME_your_address@gmail.com
SMTP_PASS=CHANGE_ME_16_char_app_password
MAIL_FROM=PRGI Title Verification <CHANGE_ME_your_address@gmail.com>

# --- Python AI service ------------------------------------------------------
AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=8000
AI_SERVICE_URL=http://127.0.0.1:8000
AI_TIMEOUT_MS=120000

# --- Neural models ----------------------------------------------------------
# LITE_MODE:  auto  = use BGE-M3 + FAISS if installed, otherwise fall back
#             true  = always use the TF-IDF fallback (no downloads)
#             false = require the real models, fail loudly if missing
LITE_MODE=auto
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
EMBEDDING_BATCH_SIZE=64
TOP_K_RETRIEVE=25
TOP_K_RERANK=10
TOP_K_RETURN=5

# --- Ollama (explanation layer only) ----------------------------------------
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=45

# --- Symbolic thresholds (tune on a labelled validation set) ----------------
T_REJECT=0.85
T_REVIEW=0.65
T_PHONETIC=0.90
T_FUZZY=0.88
T_CORE_OVERLAP=0.80
T_CROSS_LANGUAGE=0.82

# --- Similarity fusion weights (must sum to 1.0) ----------------------------
W_SEMANTIC=0.35
W_RERANK=0.25
W_FUZZY=0.20
W_PHONETIC=0.10
W_TOKEN=0.10

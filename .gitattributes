# Normalise line endings so a Windows clone and a Linux clone produce
# identical diffs. Without this, every file a Windows contributor touches
# shows up as "entire file changed".
* text=auto eol=lf

# Windows-only launchers must keep CRLF or cmd.exe mis-parses them.
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Shell scripts must keep LF even when checked out on Windows.
*.sh   text eol=lf

# Binary - never diff, never touch line endings.
*.faiss  binary
*.pkl    binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.pdf    binary
*.woff   binary
*.woff2  binary

# Keep generated lockfiles out of the diff view on GitHub.
package-lock.json  linguist-generated=true -diff

# The registry CSVs are data, not source - don't let them skew the
# language statistics bar on the repository page.
data/**  linguist-vendored=true

# ===========================================================================
#  PSS06 - PRGI Title Verification System
# ===========================================================================

# --- secrets ----------------------------------------------------------------
# .env holds the MySQL password, the JWT secret and the SMTP app password.
# Never commit it. .env.example is the committed template - keep that one.
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
service-account*.json

# --- dependencies -----------------------------------------------------------
node_modules/
.pnp
.pnp.js
.venv/
venv/
env/
ENV/
*.egg-info/
.Python

# --- build output -----------------------------------------------------------
dist/
dist-ssr/
build/
.vite/
*.local

# --- python bytecode & caches -----------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# --- generated AI artefacts --------------------------------------------------
# Rebuilt by scripts/build_faiss_index.py - do not version these.
# titles.faiss alone is ~20 MB and changes on every rebuild.
models/*
!models/README.md
*.faiss
*.pkl

# --- huggingface / torch model caches ----------------------------------------
.cache/
hf_cache/
sentence-transformers/

# --- logs & runtime ----------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pids/
*.pid
*.seed

# --- editors & OS ------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# --- coverage ----------------------------------------------------------------
coverage/
htmlcov/
.coverage
.nyc_output/

# ---------------------------------------------------------------------------
#  Frontend-only configuration (Vite).
#  Copy to frontend/.env. Everything here is bundled into the browser build,
#  so NOTHING secret may live in this file.
# ---------------------------------------------------------------------------

# Google OAuth client ID for "Continue with Google".
# Create one at https://console.cloud.google.com/apis/credentials
#   Application type : Web application
#   Authorised JavaScript origins : http://localhost:3000
#
# The client ID is public by design. Do NOT put the client *secret* here -
# this app uses the browser implicit flow and never needs it.
#
# Leave unset to disable Google sign-in; email + password still works.
VITE_GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
